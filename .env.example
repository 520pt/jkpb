# docker-compose.prod.yml 已经把常用默认值直接写好。
# 生产部署通常只需要改后台账号密码。

ADMIN_USERNAME=520pt
ADMIN_PASSWORD=520pt

# 默认启用内置个人微信群桥，不需要单独部署 LightAgent。
WECHAT_BRIDGE_ENABLED=true

# 微信查询内部 token，默认即可；不要暴露给外部。
DUTY_REMINDER_QUERY_TOKEN=520pt

# 企业微信图文消息点击详情页的公网地址。
DUTY_REMINDER_PUBLIC_URL=https://jk.79c.cc

# 查询图片、今日在岗图文详情页这类临时生成物保留天数；默认第二天可清理。
GENERATED_UPLOAD_KEEP_DAYS=1

# 可选：只给智慧养护/隧道机电接口使用的代理出口。
# 示例：DUTY_REMINDER_TUNNEL_PROXY=socks5h://127.0.0.1:10808
DUTY_REMINDER_TUNNEL_PROXY=

# 可选：企业微信智能机器人双向交互。也可以在网页「配置中心 → 消息通知渠道」里填写。
WECOM_AIBOT_ENABLED=false
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
